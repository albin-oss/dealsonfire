# PostgreSQL connection (Neon-class on Vercel; local for development)
NUXT_DATABASE_URL=postgres://user:pass@localhost:5432/dof

# Secret required by internal task routes (Vercel cron calls /api/internal/outbox-dispatch)
NUXT_CRON_SECRET=change-me

# Identity integration point. 'dev' accepts the x-dof-user-id header (NEVER in production).
# 'session' is the Identity-domain session adapter and fails closed until Identity lands.
NUXT_IDENTITY_MODE=dev

# Integration tests: point at an existing PostgreSQL to skip embedded-postgres bootstrap
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/dof_test

# ————— C10 Real Money (Stripe TEST MODE — G9 refuses sk_live outside production).
# Drop real test-mode values into a local .env (git-ignored); never commit keys.
# NUXT_STRIPE_SECRET_KEY=sk_test_...
# NUXT_STRIPE_PUBLISHABLE_KEY=pk_test_...
# NUXT_STRIPE_WEBHOOK_SECRET=whsec_...        # from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# NUXT_OPS_ALARM_EMAIL=ops@example.com        # critical alarms as letters (RM-H3)
# NUXT_OPS_USER_IDS=                          # comma-separated operator user ids
# NUXT_PLATFORM_FEE_BPS=0                     # fee VALUE is the Founder's decision
# NUXT_RISK_MAX_ORDER_MINOR=0                 # 0 = unlimited (approved policy §4)
# NUXT_RISK_MAX_MERCHANT_OPEN_DISPUTES_MINOR=0
# NUXT_RISK_MAX_MERCHANT_LOSS_MINOR=0
# NUXT_SANDBOX_CLIENT_CONFIRMATION=1          # sandbox twin mirrors the Element flow (tests/dev demos)
# NUXT_REQUIRE_MERCHANT_ONBOARDING=1          # arm the till gate without real Stripe (tests/dev demos)
